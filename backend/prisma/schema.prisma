// SQLite by default — zero-config, real persistence, runs anywhere.
// To move to Postgres later: change provider to "postgresql" and set
// DATABASE_URL to a real connection string. No other code changes needed —
// that's the entire point of using Prisma here.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Fan {
  id           String             @id @default(cuid())
  email        String             @unique
  phone        String?            @unique
  passwordHash String
  name         String
  createdAt    DateTime           @default(now())
  tickets      Ticket[]
  orders       Order[]
  pushSubs     PushSubscription[]
  smsOptIn     Boolean            @default(false)
  posts        Post[]
  likes        PostLike[]
  comments     Comment[]
  thread       Thread?
  handle       String?            @unique // public @name for fan-to-fan messages; null = not findable
  pollVotes    PollVote[]
  reports      Report[]
  dmSent       DirectMessage[]
  blocking     Block[]            @relation("blocker")
  blockedBy    Block[]            @relation("blocked")
  bio          String?
  bannedUntil  DateTime? // set by moderation; no posting or commenting until then
  rsvps        Rsvp[]
  giveaways    GiveawayEntry[]
  follows      Follow[]
}

model Owner {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // "staff" | "admin"
  createdAt    DateTime @default(now())
  tokenVersion Int      @default(0) // bump to sign out every session (e.g. password change)
}

model Artist {
  id            String       @id @default(cuid())
  name          String
  genre         String?
  soundcloudUrl String?
  slots         LineupSlot[]
}

model Event {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  status        String         @default("draft") // draft | announced | on_sale | sold_out | past
  startAt       DateTime
  doorsAt       DateTime
  venueName     String?
  venueAddr     String?
  revealMode    String         @default("checkout") // "checkout" | "timed"
  dropAt        DateTime?
  multipassSlug String? // when set, ticketing is bridged to Multipass instead of native checkout
  capacity      Int? // venue headcount limit; null = sum of tier capacities
  doorIn        Int            @default(0) // admitted (valid scans + manual admits)
  doorOut       Int            @default(0) // left the venue
  peakInside    Int            @default(0)
  entryHold     Boolean        @default(false) // true at 100%: door stops admitting
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tiers         Tier[]
  lineup        LineupSlot[]
  tickets       Ticket[]
  drops         LocationDrop[]
}

model LineupSlot {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  artist    Artist   @relation(fields: [artistId], references: [id])
  artistId  String
  startTime DateTime
  sortOrder Int      @default(0)

  @@index([eventId])
}

model Tier {
  id         String  @id @default(cuid())
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  name       String
  priceCents Int
  capacity   Int
  soldCount  Int     @default(0)
  salesOpen  Boolean @default(true)

  @@index([eventId])
}

model Order {
  id         String   @id @default(cuid())
  fan        Fan      @relation(fields: [fanId], references: [id])
  fanId      String
  totalCents Int
  status     String   @default("pending") // pending | paid | refunded | failed
  paymentRef String? // Stripe PaymentIntent id once real payments are wired in
  createdAt  DateTime @default(now())
  tickets    Ticket[]

  @@index([fanId])
}

model Ticket {
  id          String    @id @default(cuid())
  event       Event     @relation(fields: [eventId], references: [id])
  eventId     String
  fan         Fan       @relation(fields: [fanId], references: [id])
  fanId       String
  order       Order?    @relation(fields: [orderId], references: [id])
  orderId     String?
  tierName    String
  holderName  String
  qrSecret    String // per-ticket secret seed for the rotating TOTP-style code
  source      String    @default("native") // "native" | "multipass"
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  scans       ScanLog[]

  @@index([eventId])
  @@index([fanId])
}

model ScanLog {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String
  result    String // "valid" | "already_used" | "wrong_event" | "invalid_code"
  scannedBy String? // owner id
  scannedAt DateTime @default(now())

  @@index([ticketId])
}

model LocationDrop {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  venueName String
  address   String
  entryNote String?
  revealAt  DateTime
  revealed  Boolean  @default(false)

  @@index([eventId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([fanId])
}

// ---- Community feed ----
// A post is written by a fan or by the Subcurrent team (an owner account).
// authorName is stored so the feed renders without joining owners.
model Post {
  id          String     @id @default(cuid())
  fan         Fan?       @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId       String?
  ownerId     String?
  authorName  String
  fromTeam    Boolean    @default(false)
  text        String
  eventSlug   String?
  pinned      Boolean    @default(false)
  status      String     @default("visible") // visible | held | removed
  heldReason  String?
  appKey      String?    @unique // id of the matching post in the front-end prototype
  imageData   String? // data URL (jpeg/png/webp), size-capped by the API
  pollJson    String? // JSON array of option labels
  reportCount Int        @default(0)
  createdAt   DateTime   @default(now())
  likes       PostLike[]
  comments    Comment[]
  pollVotes   PollVote[]
  reports     Report[]

  @@index([status, createdAt])
}

model PostLike {
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  createdAt DateTime @default(now())

  @@id([postId, fanId])
}

model Comment {
  id         String   @id @default(cuid())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  fan        Fan?     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId      String?
  ownerId    String?
  authorName String
  fromTeam   Boolean  @default(false)
  text       String
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}

// ---- Fan <-> Subcurrent team messages ----
// One conversation per fan; any owner/staff account answers as the team.
model Thread {
  id         String    @id @default(cuid())
  fan        Fan       @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId      String    @unique
  fanUnread  Int       @default(0)
  teamUnread Int       @default(0)
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@index([updatedAt])
}

model Message {
  id         String   @id @default(cuid())
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId   String
  fromTeam   Boolean
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([threadId, createdAt])
}

model PollVote {
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  option    Int
  createdAt DateTime @default(now())

  @@id([postId, fanId])
}

model Report {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  reason    String
  createdAt DateTime @default(now())

  @@unique([postId, fanId])
}

// ---- Fan <-> fan direct messages ----
// aId < bId (sorted) so each pair has exactly one conversation.
model DirectThread {
  id        String          @id @default(cuid())
  aId       String
  bId       String
  aUnread   Int             @default(0)
  bUnread   Int             @default(0)
  updatedAt DateTime        @updatedAt
  messages  DirectMessage[]

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

model DirectMessage {
  id        String       @id @default(cuid())
  thread    DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  sender    Fan          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  text      String
  createdAt DateTime     @default(now())

  @@index([threadId, createdAt])
}

model Block {
  blocker   Fan      @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   Fan      @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

// ---- Teams portal (crew ops) ----
// Crew sign in with an owner-issued invite code (or the demo crew login).
// Names and departments are stored on each row so nothing needs a join.
model CrewInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  dept      String?
  uses      Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CrewMessage {
  id        String   @id @default(cuid())
  eventSlug String?
  channel   String // all | ops | door | sec | bar | prod | light | art
  byKey     String
  byName    String
  byDept    String?
  text      String
  alert     String? // urgent | task | break | capacity | info, for system lines
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

model CrewPing {
  id         String    @id @default(cuid())
  eventSlug  String?
  kind       String // urgent | task | break | capacity | info
  title      String
  body       String?
  toJson     String // JSON array of channels or crew keys; ["all"] = everyone
  fromKey    String
  fromName   String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  acks       CrewAck[]

  @@index([createdAt])
}

model CrewAck {
  id        String   @id @default(cuid())
  ping      CrewPing @relation(fields: [pingId], references: [id], onDelete: Cascade)
  pingId    String
  byKey     String
  byName    String
  answer    String   @default("ok") // ok | cant | done
  createdAt DateTime @default(now())

  @@unique([pingId, byKey])
}

model Incident {
  id         String    @id @default(cuid())
  eventSlug  String?
  kind       String // incident | medic | backup | other
  note       String?
  byName     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([createdAt])
}

// ---- Owner broadcast: one post to the app, Facebook, Instagram and X ----
model Broadcast {
  id          String   @id @default(cuid())
  text        String
  eventSlug   String?
  platforms   String // JSON array
  resultsJson String // JSON { platform: { status, ref?, error? } }
  postId      String?
  byName      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---- Crew shifts: clock in/out and breaks, the hours behind team pay ----
model CrewShift {
  id        String    @id @default(cuid())
  eventSlug String?
  byKey     String
  byName    String
  dept      String?
  inAt      DateTime  @default(now())
  outAt     DateTime?
  breakAt   DateTime? // set while on break
  breakMins Int       @default(0)

  @@index([byKey, outAt])
  @@index([inAt])
}

// ---- Owner books: the team roster, purchases and recurring bills ----
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("Crew")
  rateCents Int      @default(0)
  basis     String   @default("hour") // hour | night | flat
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  kind        String   @default("purchase") // purchase | bill
  vendor      String
  category    String   @default("other")
  amountCents Int
  eventSlug   String?
  spentAt     DateTime @default(now())
  note        String?
  byName      String
  createdAt   DateTime @default(now())

  @@index([eventSlug])
  @@index([spentAt])
}

// ---- Fan intent: going, giveaway entries, follows ----
model Rsvp {
  eventSlug String
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  createdAt DateTime @default(now())

  @@id([eventSlug, fanId])
}

model GiveawayEntry {
  eventSlug String
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  won       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([eventSlug, fanId])
}

model Follow {
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  fanId     String
  target    String // a fan @handle, or "artist:<id>"
  createdAt DateTime @default(now())

  @@id([fanId, target])
  @@index([target])
}
